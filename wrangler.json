{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Hackathon",
    "BENCHMARK_API_URL": "https://verifi-backend-cuzo.onrender.com/",
    "CHAT_API_URL": "https://verifi-concierge.onrender.com/api/chat",
    "QSTASH_URL": "https://qstash-us-east-1.upstash.io/",
    "NEXT_PUBLIC_APP_URL": "https://frontend.shresthjindal28.workers.dev",
    "BETTER_AUTH_URL": "https://frontend.shresthjindal28.workers.dev"
  }
}
